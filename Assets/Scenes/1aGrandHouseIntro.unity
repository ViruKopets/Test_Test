  DialoguePanel: {fileID: 1353618661}
  Imgs:
  - {fileID: 3751904156327893308, guid: 8bf3d9f2010a3a341a0b3b6662180505, type: 3}
  - {fileID: -3152806621488777424, guid: 7d53f1721ee1a004aba8634efb51cc98, type: 3}
  - {fileID: 5510741715754306470, guid: 2de49931e21311944a0d331a5aea3754, type: 3}
  - {fileID: -3152806621488777424, guid: 7d53f1721ee1a004aba8634efb51cc98, type: 3}
  Words:
  - "\u0411\u0430\u0431\u0443\u043B\u044F \u0410\u0433\u0430\u0442\u0430, \u0430
    \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0438\u0442\u0435 \u043A\u0430\u043A\u0443\u044E-\u043D\u0438\u0431\u0443\u0434\u044C
    \u0442\u0430\u0439\u043D\u0443 \u044D\u0442\u043E\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u0430.
    \u0427\u0442\u043E-\u0442\u043E \u0436\u0443\u0442\u043A\u043E\u0435 \u0438 \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u043E\u0435!"
  - "\u0412 \u043D\u0430\u0448\u0435\u043C \u043B\u0435\u0441\u0443\u2026 \u0445\u043E\u0434\u044F\u0442
    \u0441\u043B\u0443\u0445\u0438. \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u043E\u043D
    \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u0442\u0435\u0445, \u043A\u0442\u043E
    \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0433\u043B\u0443\u0431\u043E\u043A\u043E
    \u0437\u0430\u0448\u0435\u043B."
  - "\u0412\u044B\u0431\u0438\u0440\u0430\u0435\u0442? \u041A\u0430\u043A \u044D\u0442\u043E?"
  - "\u041D\u043E \u044D\u0442\u043E \u0432\u0441\u0451 \u0441\u0442\u0430\u0440\u044B\u0435
    \u0441\u043A\u0430\u0437\u043A\u0438. \u0417\u0430\u0431\u0443\u0434\u044C\u0442\u0435.
    \u0418 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u0435 \u043E\u0434\u043D\u043E:
    \u043D\u0435 \u0445\u043E\u0434\u0438\u0442\u0435 \u0432 \u043B\u0435\u0441."
  Names:
  - "\u041B\u0443\u043A\u0430"
  - "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u0410\u0433\u0430\u0442\u0430"
  - "\u0410\u043B\u0438\u0441\u0430"
  - "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u0410\u0433\u0430\u0442\u0430"
