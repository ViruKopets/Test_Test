  m_text: "\u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 \u0410\u043B\u0438\u0441\u0430,
    \u043C\u043E\u0438 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438 \u0440\u0430\u0437\u0432\u0435\u043B\u0438\u0441\u044C
    \u0438 \u043C\u0430\u043C\u0430 \u043F\u043E \u0440\u0430\u0431\u043E\u0442\u0435
    \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B\u0430 \u0432 \u043A\u0430\u043A\u0443\u044E-\u0442\u043E
    \u0433\u043B\u0443\u0448\u044C \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0432
    \u043C\u0435\u043D\u044F \u0441 \u0441\u043E\u0431\u043E\u0439. \u0418\u0437
    \u043C\u043E\u0438\u0445 \u0440\u043E\u0432\u0435\u0441\u0442\u043D\u0438\u043A\u043E\u0432
    \u043D\u0435\u0434\u0430\u0432\u043D\u043E \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u0432\u0448\u0438\u0445
    \u0441\u044E\u0434\u0430 \u0437\u0434\u0435\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E
    \u041B\u0443\u043A\u0430. \u0411\u0435\u0437 \u043D\u0435\u0433\u043E \u0442\u0443\u0442
    \u0431\u044B\u043B\u0430 \u0431\u044B \u0442\u043E\u0441\u043A\u0430 \u0437\u0435\u043B\u0435\u043D\u0430\u044F.
    \u041C\u0430\u043C\u044B \u0447\u0430\u0441\u0442\u043E \u043D\u0435\u0442 \u0438
    \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043C\u044B \u0447\u0430\u0441\u0442\u043E
    \u0441\u0438\u0434\u0438\u043C \u0443 \u0441\u043E\u0441\u0435\u0434\u0441\u043A\u043E\u0439
    \u0431\u0430\u0431\u0443\u0448\u043A\u0438."
