      objectReference: {fileID: 0}
    - target: {fileID: 1806978606130606109, guid: ffe7f07841836b349b148546b28fb6e9, type: 3}
      propertyPath: 'Words.Array.data[3]'
      value: "\u041B\u0443\u043A\u0430 \u0445\u043E\u0442\u0435\u043B \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
