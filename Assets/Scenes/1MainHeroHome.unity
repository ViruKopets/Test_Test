    - target: {fileID: 1806978606130606109, guid: ffe7f07841836b349b148546b28fb6e9, type: 3}
      propertyPath: 'Words.Array.data[0]'
      value: "\u0410\u043B\u0438\u0441\u0430, \u044F \u0443\u0445\u043E\u0436\u0443
        \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443. \u041E\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044F
        \u0434\u043E\u043C\u0430. "
      objectReference: {fileID: 0}
    - target: {fileID: 1806978606130606109, guid: ffe7f07841836b349b148546b28fb6e9, type: 3}
      propertyPath: 'Words.Array.data[1]'
      value: "\u041D\u0435 \u0445\u0432\u0430\u0442\u0430\u043B\u043E, \u0447\u0442\u043E\u0431\u044B
        \u0435\u0449\u0451 \u0438 \u0442\u044B \u043F\u0440\u043E\u043F\u0430\u043B\u0430\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 1806978606130606109, guid: ffe7f07841836b349b148546b28fb6e9, type: 3}
      propertyPath: 'Words.Array.data[2]'
      value: "\u041F\u0440\u043E\u0441\u0442\u0438, \u043C\u0430\u043C\u2026 \u041D\u043E
